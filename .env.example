# Copy to .env. Relative paths are resolved from the repository root.
REFCOCO_IMAGES_DIR=./data/coco/train2014
REFCOCO_ANNOTATIONS_DIR=./data/refcoco
JAG_MODELS_DIR=./models
JAG_OUTPUTS_DIR=./outputs
JAG_CACHE_DIR=./.cache
JAG_IMAGE=jag:local

# Physical GPU IDs for your environment.
GPU_IDS=0
EVAL_GPU=0
# Defaults to the number of GPU_IDS; may be reduced explicitly.
# JAG_NPROC_PER_NODE=4

# SwanLab is disabled unless train.sh receives --swanlab.
# Prefer exporting SWANLAB_API_KEY in your shell, or create
# .secrets/swanlab_api_key (ignored by Git; never commit a real key).
# SWANLAB_API_KEY_FILE=/workspace/Jag/.secrets/swanlab_api_key
